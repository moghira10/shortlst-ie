# shortlst-ie — Practice interviews for candidates
# ────────────────────────────────────────────────
# Copy to .env.local for local dev:   cp .env.example .env.local
# Reuses the SAME Supabase project and interview engine as asparagus (shortlst.me).

# ── App URL ───────────────────────────────────────────────────────────────────
# Public URL of THIS app. The engine posts completion webhooks to
# ${NEXT_PUBLIC_APP_URL}/api/webhooks/interview-complete, so it must be reachable
# from the engine (use a tunnel such as ngrok for local dev).
NEXT_PUBLIC_APP_URL=http://localhost:3100

# ── Supabase (same project as asparagus) ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_YOUR_SERVICE_ROLE_KEY

# ── Interview engine (same engine as asparagus) ──────────────────────────────
INTERVIEW_ENGINE_URL=http://127.0.0.1:8000
# Must match INTERNAL_API_KEY in the interview engine's .env
INTERVIEW_ENGINE_API_KEY=REPLACE_ME
# Must match WEBHOOK_SECRET in the interview engine's .env
WEBHOOK_SECRET=REPLACE_ME

# ── Practice limits ──────────────────────────────────────────────────────────
# Practice interviews each user may start in a rolling 30-day window.
PRACTICE_MONTHLY_LIMIT=3
# Sent to the engine as recruiter_id so practice sessions are distinguishable
# from real hiring sessions in engine logs/metrics.
PRACTICE_RECRUITER_ID=shortlst-practice
